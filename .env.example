# Copy to .env and fill in your paths.

# Directory containing the extracted FRED sequences (sequence_84/, sequence_127/, …)
# Each folder must contain: Event/, RGB/, coordinates.txt
FRED_DATA_PATH=/path/to/fred/sequences

# Writable directory for reconstructed frames and detection results
# Can be empty — the pipeline writes here as it runs
RECON_DATA_PATH=/path/to/recon/output
